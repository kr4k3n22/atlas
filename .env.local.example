# ============================================================
# ATLAS HITL UI — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Supabase (Public) ---
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# --- Supabase (Server-only) ---
# Service-role key — never expose this to the browser.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# --- OpenAI ---
# Required for the ChatGPT-powered Agent AI Chatbot (function calling for MCP tool selection,
# friendly response formatting, and safe/general question handling).
# When not set, the app falls back to regex-based tool detection.
OPENAI_API_KEY=<your-openai-api-key>
# Optional — controls the model used by both chatWithTools() and chatCompletion().
# chatWithTools() defaults to gpt-4o-mini; chatCompletion() defaults to gpt-4o.
# Set this to override both (e.g., gpt-4o-mini to reduce cost).
OPENAI_MODEL=gpt-4o-mini

# --- Gateway Integration ---
# The URL where Atlas-MCP-Gateway is deployed.
GATEWAY_URL=https://<your-gateway-deployment>.vercel.app

# Shared Bearer token between the Gateway and this UI.
# The Gateway uses this token when POSTing to /api/gateway/ingest.
# This UI uses it when POSTing decisions back to /webhook/approval.
# Generate a strong value with: openssl rand -hex 32
GATEWAY_SHARED_SECRET=<generate-with-openssl-rand-hex-32>

# --- Email Notifications (Case Approval) ---
# When a case is approved, ATLAS sends an email to the implementation team.
# Uses Proton Mail via the Proton Mail Bridge (a local SMTP relay).
#
# Steps to configure:
#   1. Install Proton Mail Bridge on the machine running ATLAS (or a reachable server).
#      Download: https://proton.me/mail/bridge
#   2. Sign in to Bridge with your Proton Mail account (AtlasCaseActions@proton.me).
#   3. In Bridge, open the account details to get the Bridge-generated SMTP password.
#      (This is NOT your Proton account password.)
#   4. Set EMAIL_FROM and EMAIL_SMTP_PASSWORD below.
#   5. If Bridge is running on a different host/port, set EMAIL_SMTP_HOST / EMAIL_SMTP_PORT.
#
# If these variables are not set, email sending is silently skipped.
EMAIL_FROM=AtlasCaseActions@proton.me
EMAIL_SMTP_PASSWORD=<bridge-generated-smtp-password>
EMAIL_TO=implementation-team@example.com

# Proton Mail Bridge SMTP defaults — only change these if Bridge runs on a non-standard host/port.
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
# Set to "true" only if using port 465 (SSL). Leave unset or "false" for port 1025/587 (STARTTLS).
# EMAIL_SMTP_SECURE=false
